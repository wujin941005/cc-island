# CC Island local config — copy to `.env` and fill in your values.
# `.env` is gitignored; these are personal/secret so never commit it.

# WiFi for the watch — read by scripts/install_firmware.sh at build time and
# baked into firmware/app_codex/net/net_config.h in the build-firmware checkout.
CC_WIFI_SSID=your_wifi_ssid
CC_WIFI_PASSWORD=your_wifi_password
CC_BRIDGE_HOST=192.168.1.100
CC_BRIDGE_PORT=8080
CC_LAYOUT=pages
CC_SYSTEM_MONITOR=false
CC_AUTO_SWITCH_MS=0
CC_POLL_MS=5000

# Optional CLI data-directory overrides. Defaults are auto-detected on native
# Windows/macOS/Linux; WSL also checks the mounted Windows user profile.
# CODEX_HOME=~/.codex
# CLAUDE_CONFIG_DIR=~/.claude
# OPENCODE_DB=~/.local/share/opencode/opencode.db

# Optional API-equivalent pricing controls. The bridge uses OpenRouter's public
# model catalog, refreshes it every 6 hours, and keeps a last-good disk cache.
# CC_PRICING_REFRESH_HOURS=6
# CC_PRICING_CACHE=~/.cache/cc-island/openrouter-pricing.json
# CC_CODEX_FALLBACK_MODEL=gpt-5.6-sol

# OpenCode Go quota — read by bridge/codexisland_bridge.py at runtime.
# Workspace id from the Go page URL under https://opencode.ai/console/.
# Cookie: F12 → Application → Cookies → https://opencode.ai →
# `__Host-console_session` (starts with "st_" and expires periodically).
# The existing AUTH_COOKIE setting also accepts legacy "Fe26.2**" auth cookies.
OPENCODE_GO_WORKSPACE_ID=wrk_xxxxxxxx
OPENCODE_GO_AUTH_COOKIE=st_your_session_cookie
